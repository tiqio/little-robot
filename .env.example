# ===== 模型：本地 or 云端 =====
USE_LOCAL=false
LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL=huihui-qwen3.8-27b-abliterated@iq2_s
REMOTE_BASE_URL=https://api.deepseek.com
REMOTE_MODEL=deepseek-flash
REMOTE_API_KEY=sk-xxx

# ===== 思考/输出预算（ch32/ch33）=====
# 思考/行动分家：思考型模型跑两段（思考段→行动段），两段预算分开，思考吃不到行动的份。
# 本地默认开、云端默认关；要关就设 off。
THINKING=on
# 单段（关思考或云端）的输出上限
LOCAL_MAX_TOKENS=2048
# 两段的输出上限（14 tok/s 下 2048 思考 ≈ 最差 2.4 分钟）
LOCAL_THINK_TOKENS=2048
LOCAL_ACT_TOKENS=1024
# 逃生门：彻底关掉 Qwen3 的思考（enable_thinking:false），输出又快又稳但不假思索
LOCAL_NO_THINK=false

# ===== 飞书 =====
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# ===== 图源（都可选）=====
PEXELS_API_KEY=           # 真实照片第一源，没有就自动降级到 Openverse/Wikimedia
NHENTAI_API_KEY=          # nhentai 官方 zip 下载接口（后台 API Keys 页创建）；没有就逐页下载自己打 zip

# ===== 运行超时 =====
# 单次任务上限（分钟）。本地 27B + 多轮工具 + 下载/合成 PDF，10 分钟容易撞线
RUN_TIMEOUT_MIN=20

# ===== 工作区与调试 =====
ROBOT_WORKDIR=./workspace
LLM_REQUEST_DEBUG=false